# =============================================================================
# ResolveAI PRODUCTION environment template (docker-compose.prod.yml / ECS task defs).
# Copy to .env.prod, fill every CHANGE_ME, keep it out of git (it is ignored), and
# prefer injecting secrets from AWS Secrets Manager / SSM in real deployments.
# `python manage.py check --deploy --fail-level ERROR` refuses unsafe values.
# =============================================================================
DJANGO_ENV=prod
DJANGO_SECRET_KEY=CHANGE_ME_64_random_chars   # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_ADMIN_URL=ops-CHANGE_ME/
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
TRUSTED_PROXY_COUNT=1
SECURE_SSL_REDIRECT=true

POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=CHANGE_ME
DB_POOL=true
DB_POOL_MAX_SIZE=10

FIELD_ENCRYPTION_KEY=CHANGE_ME   # Fernet.generate_key(); back it up — losing it loses integration URLs

LOG_FORMAT=json
LOG_ACCESS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=

NOTIFICATION_BACKEND=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=ResolveAI

AWS_STORAGE_BUCKET_NAME=CHANGE_ME
AWS_S3_REGION_NAME=ap-south-1

ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
EMBEDDING_PROVIDER=openai

STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Build-time values for the dashboard image (browser-visible, not secrets).
PUBLIC_WS_URL=
PUBLIC_WIDGET_SCRIPT_URL=https://cdn.example.com/widget.js
PUBLIC_WIDGET_API_URL=https://app.example.com
