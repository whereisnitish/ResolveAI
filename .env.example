# =============================================================================
# ResolveAI environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets. All values below are
# placeholders that are safe for local development only.
# =============================================================================

# --- Django core --------------------------------------------------------------
# One of: dev | test | prod  (selects config.settings.<env>)
DJANGO_ENV=dev
# Generate for real environments: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-local-dev-only-not-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Public URL of the dashboard frontend (used in emails: verification, reset, invites)
FRONTEND_URL=http://localhost:3000
# Origins allowed to make credentialed requests to the API (dashboard only).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ----------------------------------------
POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optional: overrides the individual POSTGRES_* settings when set.
# DATABASE_URL=postgres://resolveai:resolveai-local-password@localhost:5433/resolveai

# --- Redis (cache, Channels layer, Celery broker) ----------------------------
# Host ports default to 5433/6380 to avoid clashing with other local stacks.
# Override with POSTGRES_HOST_PORT / REDIS_HOST_PORT for docker compose.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
CHANNEL_LAYER_REDIS_URL=redis://localhost:6380/3

# --- Email -------------------------------------------------------------------
# Dev default prints emails to the backend console.
# NOTIFICATION_BACKEND: console (print emails to the worker log) | smtp
NOTIFICATION_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_PASSWORD=
# Not supported yet — inject the secret into SMTP_PASSWORD at deploy time instead.
SMTP_PASSWORD_VAULT_REF=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=ResolveAI

# --- Session / security ------------------------------------------------------
SESSION_COOKIE_AGE_SECONDS=1209600
# Number of reverse proxies in front of Django (e.g. 1 behind an ALB). 0 ignores X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
# Set true behind HTTPS in production
SECURE_COOKIES=false
EMAIL_VERIFICATION_MAX_AGE_SECONDS=172800
INVITATION_EXPIRY_DAYS=7

# --- Website widget & attachments -------------------------------------------
# Lifetime of widget visitor session tokens (refreshed automatically by the widget).
WIDGET_SESSION_TTL_SECONDS=3600
# Maximum attachment size in bytes (default 10 MB).
ATTACHMENT_MAX_BYTES=10485760

# --- Object storage (S3-compatible). Empty bucket = local disk (dev). ---------
# Used for conversation attachments (Phase 2) and knowledge uploads (Phase 3).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI (Phase 3) ---------------------------------------------------------------
# Leave keys empty to use the offline mock provider in development.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
# Fall back to the mock provider when a key is missing (forced off in production settings).
AI_ALLOW_MOCK_FALLBACK=true
# auto = OpenAI embeddings when OPENAI_API_KEY is set, else local hashing embeddings.
# Changing the embedding model requires re-indexing knowledge sources.
EMBEDDING_PROVIDER=auto
KNOWLEDGE_MAX_FILE_BYTES=20971520
# Run Celery tasks inline without a worker (single-process local debugging only).
CELERY_TASK_ALWAYS_EAGER=false

# --- Payments (Phase 4). Without keys, dev uses a signed mock provider ----------
# Stripe serves international customers; Razorpay serves organizations with country=IN.
# Razorpay plan ids per plan/currency are configured on Plan.provider_prices (Django admin).
BILLING_ALLOW_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Secrets at rest (integration URLs). REQUIRED in production. --------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Frontend (Next.js) ------------------------------------------------------
# Frontend variables live in frontend/.env.local (see frontend/.env.example):
# BACKEND_INTERNAL_URL, NEXT_PUBLIC_WS_URL, NEXT_PUBLIC_WIDGET_SCRIPT_URL, NEXT_PUBLIC_WIDGET_API_URL

# --- Production readiness (Phase 5) -------------------------------------------
# Logs: text (dev) | json (default in prod). LOG_ACCESS=true emits one access log per request.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_ACCESS=false
# Error tracking. Empty = disabled. PII (bodies, cookies, auth headers, query strings) is scrubbed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0
# Release identifier attached to errors/logs (CI sets it to the git SHA).
APP_RELEASE=
# Database connections: DB_POOL=true uses psycopg's in-process pool (CONN_MAX_AGE forced to 0).
# Behind PgBouncer (transaction mode) keep DB_POOL=false and set DB_CONN_MAX_AGE=0.
DB_POOL=false
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONN_MAX_AGE=60
# Server-side statement timeout (ms). 0 disables (use for long migrations only).
DB_STATEMENT_TIMEOUT_MS=30000
# Per-account login lockout (distributed brute force), on top of per-IP throttling.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900
