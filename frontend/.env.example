# Frontend environment (copy to .env.local). NEXT_PUBLIC_* values are embedded
# in the browser bundle — never put secrets here.

# Server-side only: where Next.js proxies /api/* to.
BACKEND_INTERNAL_URL=http://localhost:8000

# Dashboard WebSocket base URL. Omit in production when /ws/* is routed to Django
# on the same origin; in local dev point it at the Django server.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Shown in Settings → Widget install snippet.
NEXT_PUBLIC_WIDGET_SCRIPT_URL=http://localhost:3002/widget.js
NEXT_PUBLIC_WIDGET_API_URL=http://localhost:8000
